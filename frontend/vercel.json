{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REEMPLAZAR-CON-TU-BACKEND.onrender.com/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://REEMPLAZAR-CON-TU-BACKEND.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://REEMPLAZAR-CON-TU-BACKEND.onrender.com/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
