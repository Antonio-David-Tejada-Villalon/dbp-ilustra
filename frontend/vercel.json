{
  "rewrites": [
    { "source": "/api", "destination": "https://dbp-ilustra.onrender.com/api" },
    { "source": "/api/(.*)", "destination": "https://dbp-ilustra.onrender.com/api/$1" },
    { "source": "/admin", "destination": "https://dbp-ilustra.onrender.com/admin" },
    { "source": "/admin/(.*)", "destination": "https://dbp-ilustra.onrender.com/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://dbp-ilustra.onrender.com/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
