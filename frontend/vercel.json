{
  "rewrites": [
    { "source": "/api", "destination": "https://dbp-ilustra.onrender.com/api" },
    { "source": "/api/:path*", "destination": "https://dbp-ilustra.onrender.com/api/:path*" },
    { "source": "/admin", "destination": "https://dbp-ilustra.onrender.com/admin" },
    { "source": "/admin/", "destination": "https://dbp-ilustra.onrender.com/admin/" },
    { "source": "/admin/:path*", "destination": "https://dbp-ilustra.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://dbp-ilustra.onrender.com/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
