# Copiá este archivo como .env y completá los valores.

# --- Django ---
# Generá una clave con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# En producción con HTTPS:
COOKIE_SECURE=0

# --- Base de datos ---
# Local sin Docker (PostgreSQL instalado):  postgres://ilustra:CLAVE@localhost:5432/ilustra
# Si no la definís, se usa SQLite (backend/db.sqlite3) para desarrollo rápido.
DATABASE_URL=
POSTGRES_PASSWORD=ilustra-local

# --- Ingreso con Google (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web") ---
# Orígenes autorizados: http://localhost:5173, http://localhost:8000 y tu dominio.
GOOGLE_CLIENT_ID=

# --- Asistente (Google AI Studio → API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Imágenes ---
# Hosts permitidos para enlaces de obras, separados por coma (vacío = cualquier sitio público).
# Ejemplo: i.imgur.com,i.ibb.co,res.cloudinary.com
IMAGE_ALLOWED_HOSTS=
MAX_IMAGE_BYTES=15728640

# --- Solo desarrollo: permite /api/auth/dev-login sin Google (requiere DEBUG=1) ---
DEV_LOGIN=0
